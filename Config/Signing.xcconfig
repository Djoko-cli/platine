// Signature de l'app. L'équipe de développement et le portier d'OwnTone sont propres à chaque installation :
// elles se règlent dans Local.xcconfig, à côté de ce fichier, non versionné.
// Contenu attendu de Local.xcconfig :
//   DEVELOPMENT_TEAM = <identifiant de l'équipe>
//   PLATINE_PORTIER = https:/$()/<nom public du portier>   (voir portier/)
//   PLATINE_JETON = <jeton du portier, celui du .env sur le NAS>
//   PLATINE_PAIRES = <id sortie>+<id sortie>[=<nom affiché>], séparées par des virgules   (facultatif)
CODE_SIGN_STYLE = Automatic
#include? "Local.xcconfig"
